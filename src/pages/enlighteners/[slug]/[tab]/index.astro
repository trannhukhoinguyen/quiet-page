---
import "@/styles/wiki-type/slug.wiki.css"
import "@/styles/wiki-type/tab.wiki.css"
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/wiki-type/EnlightenerLayout.astro";
import { getEnlightenerSlug, getEnlightenerUrl } from "@/utils/enlighteners.ts";
import ALL_ENLIGHTENERS from "@/data/enlighteners/AllEnlightenersDb.tsx";
import CopyCode from '@/components/ui/minrock-style/CopyCode.astro';
import RelatedPostList from "@/components/postList/RelatedPostList.astro";

export async function getStaticPaths() {
  const enlighteners = await getCollection("enlighteners");
  const paths = [];

  for (const entry of enlighteners) {
    const slug = getEnlightenerSlug(entry);

    // Nếu không khai báo tabLabels trong YAML
    const rawTabLabels = entry.data.tabLabels && entry.data.tabLabels.length > 0
      ? entry.data.tabLabels
      : ["doi-thoai", "bai-giang"];

    for (const tab of rawTabLabels) {
      const tabSlug = tab.toLowerCase().trim().replace(/\s+/g, "-");

      paths.push({
        params: { slug, tab: tabSlug },
        props: { entry, currentTab: tabSlug },
      });
    }
  }

  return paths;
}

interface Props {
  entry: CollectionEntry<"enlighteners">;
  currentTab: string;
}

const { entry, currentTab } = Astro.props;
const { Content, headings } = await render(entry);
const allEnlighteners = await getCollection("enlighteners");
const showThisAudio = entry.data.audio;

const wordCount = entry.body ? entry.body.trim().split(/\s+/).filter(Boolean).length : 0;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const entrySlug = getEnlightenerSlug(entry);

// Kiểm tra nội dung bài viết có thực sự chứa các tab con này không
const hasDialogue = entry.body?.includes('class="tab-dialogue"') && entry.body?.includes('id="dialogue"') || false;
const hasSermon = entry.body?.includes('class="tab-sermon"') && entry.body?.includes('id="sermon"') || false;

// Nếu YAML khai báo
const nameEn = entrySlug.split('-').join(' ') || "";

const enlightenerTmp = ALL_ENLIGHTENERS
  ?.find(enlightener => enlightener.name_en === nameEn);

const birthDeath = entry.data.birthDeath ? entry.data.birthDeath : enlightenerTmp?.birth_death_time?.join(' - ');
const zenSchool = [...(entry.data.zenSchool ? entry.data.zenSchool : enlightenerTmp?.sect || [])];
const places = entry.data.places ? entry.data.places : [enlightenerTmp?.place];

const extraNames = entry.data.extraNames ? entry.data.extraNames : enlightenerTmp
  ? `${ enlightenerTmp.name_zh ? "🇨🇳 " + enlightenerTmp.name_py + " " + enlightenerTmp.name_zh : ""}
    ${ enlightenerTmp.name_ja ? " - 🇯🇵 " + enlightenerTmp.name_ja : ""}
    ${ enlightenerTmp.name_kr ? " - 🇰🇷 " + enlightenerTmp.name_kr : ""}`
  : "";

const teachersTmp = ALL_ENLIGHTENERS
  ?.find(enlightener => enlightener.name_en === nameEn)
  ?.teachers;
const teachers = [...(entry.data.teachers?.length ? entry.data.teachers : teachersTmp && teachersTmp.length ? teachersTmp : [])];

const disciplesTmp = ALL_ENLIGHTENERS
  .filter(enlightener => enlightener.teachers?.includes(nameEn))
  .map(({name_en, name_vi, name_ja, name_kr, ...others}) => ({slug: name_en.split(' ').join('-'), name_en, name_vi, name_ja, name_kr}));
const disciples = [...(entry.data.disciples?.length ? entry.data.disciples : disciplesTmp.length ? disciplesTmp : [])];

const meansTmp = ALL_ENLIGHTENERS.filter(enlightener => enlightener.teachers?.includes(nameEn)).map(({means, ...others}) => ({means}));
const mantrasTmp = ALL_ENLIGHTENERS.filter(enlightener => enlightener.teachers?.includes(nameEn)).map(({mantras, ...others}) => ({mantras}));

const mantras = [...(entry.data.mantras?.length ? entry.data.mantras : mantrasTmp.length ? mantrasTmp : [])];
const means = [...(entry.data.means?.length ? entry.data.means : meansTmp.length ? meansTmp : [])];

// Nếu YAML chưa khai báo tabLabels nhưng bài viết có import nội dung Dialogue/Sermon, ta tự động thêm vào
let tabLabels = [...(entry.data.tabLabels || [])];

if (tabLabels.length === 0) {
  if (hasDialogue) tabLabels.push("doi-thoai");
  if (hasSermon) tabLabels.push("bai-giang");
} else {

  // Nếu có khai báo, ta lọc lại để chắc chắn chỉ hiện tab nào thực sự có div tồn tại trong bài
  tabLabels = tabLabels.filter(label => {
    const slug = label.toLowerCase().trim();
    if (slug === 'doi-thoai') return hasDialogue;
    if (slug === 'bai-giang') return hasSermon;
    return true;
  });
}

// Lấy thông tin navigation (tương tự index.astro)
const enlightenersForNavigation = allEnlighteners
  .filter((e) => entry.data.category ? e.data.category === entry.data.category : true)
  .map((e, idx) => ({ ...e, order: idx }));

const currentIndex = enlightenersForNavigation.findIndex((e) => getEnlightenerSlug(e) === entrySlug);
const previousEnlightener = currentIndex > 0 ? enlightenersForNavigation[currentIndex - 1] : undefined;
const nextEnlightener = currentIndex >= 0 && currentIndex < enlightenersForNavigation.length - 1 ? enlightenersForNavigation[currentIndex + 1] : undefined;

const relatedArticles = allEnlighteners
  .filter((e) => getEnlightenerSlug(e) !== entrySlug)
  .filter((e) => e.data.category === entry.data.category)
  .slice(0, 5)
  .map((e) => ({
    title: e.data.title,
    description: e.data.description || `Tìm hiểu thêm về ${e.data.title}`,
    href: getEnlightenerUrl(e),
  }));
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  currentSlug={entrySlug}
  headings={headings}
  articleData={{
    publishedTime: entry.data.publishedDate?.toISOString(),
    modifiedTime: entry.data.lastUpdated?.toISOString(),
    birthDeath,
    extraNames,
    zenSchool,
    teachers,
    places,
    tags: entry.data.tags,
    readTimeMinutes,
  }}
  navigationData={{
    previous: previousEnlightener ? { title: previousEnlightener.data.title, href: getEnlightenerUrl(previousEnlightener) } : undefined,
    next: nextEnlightener ? { title: nextEnlightener.data.title, href: getEnlightenerUrl(nextEnlightener) } : undefined,
  }}
  relatedArticles={relatedArticles}
  tabLabels={tabLabels}
  means={means || []}
  mantras={mantras || []}
  disciples={disciples}
  activeTab={currentTab}
  showThisAudio={showThisAudio}
>
  <Content />

  <CopyCode />
</Layout>
