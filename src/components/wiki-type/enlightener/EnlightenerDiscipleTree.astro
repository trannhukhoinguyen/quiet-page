---
export interface Disciple {
  name_vi: string;
  slug?: string;
  name_en?: string;
  name_zh?: string
  name_ja?: string
  name_kr?: string
}

interface Props {
  title?: string;
  disciples?: Disciple[];
  maxInitialDisplay?: number; // Số lượng hiển thị mặc định trước khi collapse (mặc định là 2)
}

const { disciples = [], title = "🚸 SƠ ĐỒ TRUYỀN ĐĂNG", maxInitialDisplay = 2 } = Astro.props;
const remainedDisciples = disciples.length - maxInitialDisplay;
---

<div
  class="disciple-tree-wrapper"
  x-data="{ isExpanded: false }"
  x-init="
        window.addEventListener('keydown', (e) => {
          // Kiểm tra tổ hợp phím: Ctrl + Alt + C (không phân biệt chữ hoa/thường)
          if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'c') {
            e.preventDefault(); // Ngăn trình duyệt kích hoạt các phím tắt mặc định nếu có
            isExpanded = !isExpanded; // Đảo trạng thái collapse y hệt như khi click button
          }
        })
      "
>
  {title && <h3 class="disciple-tree-header">
    {title} <span style="color: var(--color-accent-greenyellow)">{disciples.length ? `(${disciples.length})` : ''}</span>
  </h3>}

  <div class="disciple-tree-container">
    <ul class="disciple-tree-list">
      {disciples.map((disciple, index) => (
        <li
          class={`disciple-tree-item ${index >= maxInitialDisplay ? 'extra-node' : ''}`}
          x-show={index >= maxInitialDisplay ? "isExpanded" : "true"}
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 transform -translate-y-2"
          x-transition:enter-end="opacity-100 transform translate-y-0"
        >
          <div class="disciple-node-marker" title={`${index + 1}`}></div>

          <div class="disciple-node-card">
            {
              disciple.slug && disciple.name_vi
                ? <a
                  href={"/enlighteners/" + disciple.slug}
                  target="_blank"
                  title={`${disciple.name_en ? `${disciple.name_en}` : ''} ${disciple.name_zh ? ` ${disciple.name_zh}` : ''} ${disciple.name_ja ? ` ${disciple.name_ja}` : ''} ${disciple.name_kr ? ` ${disciple.name_kr}` : ''}`}
                >{disciple.name_vi}</a>
                : disciple.name_vi
                  ? <span
                    title={`${disciple.name_en ? `${disciple.name_en}` : ''} ${disciple.name_zh ? ` ${disciple.name_zh}` : ''} ${disciple.name_ja ? ` ${disciple.name_ja}` : ''} ${disciple.name_kr ? ` ${disciple.name_kr}` : ''}`}
                  >{disciple.name_vi}</span>
                  : ""
            }
          </div>
        </li>
      ))}
    </ul>
  </div>

  {/* Nút bấm Bung ra / Thu gọn nếu số lượng phần tử vượt quá giới hạn */}
  {remainedDisciples > 0 && (
    <div class="disciple-expand-control">
      <button
        title="Ấn tổ hợp phím Ctrl + Alt + C để mở / đóng collapse"
        type="button"
        class="expand-toggle-btn"
        @click="isExpanded = !isExpanded"
      >
        <span x-text="isExpanded ? 'Thu gọn' : 'Xem hết'"></span>
        <svg
          class="expand-chevron"
          :class="{ 'rotate-180': isExpanded }"
          width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        (+ {remainedDisciples})
      </button>
    </div>
  )}
</div>

<style>
  // COLLAPSE
  .disciple-tree-wrapper {
    margin: 2rem 0;
    padding: 1.5rem;
    background-color: var(--sgkb-bg-card, #121212);
    border: 1px solid var(--sgkb-border, #2a2a2a);
    border-radius: 12px;
  }

  .disciple-tree-header {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sgkb-text-main, #ffffff);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--sgkb-border, #2a2a2a);
    padding-bottom: 0.75rem;
  }

  .disciple-tree-container {
    position: relative;
    padding: 0.5rem 0 0.5rem 1rem;
  }

  .disciple-tree-line {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 1.85rem;
    width: 2px;
    background: linear-gradient(180deg, var(--sgkb-primary, #d4af37) 0%, rgba(212, 175, 55, 0.2) 100%);
  }

  .disciple-tree-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.5rem;
  }

  .disciple-tree-item {
    position: relative;
    display: flex;
    gap: 1.5rem;
  }

  .disciple-node-marker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    padding-top: 0.85rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #000;
    border: 2px solid var(--sgkb-primary, #d4af37);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
    flex-shrink: 0;
    margin-left: 2px;

    span {
      display: flex;
    }
  }

  .disciple-node-card {
    flex: 1;
    background-color: var(--sgkb-bg-gray, #1a1a1a);
    border: 1px solid var(--sgkb-border, #333333);
    border-radius: 10px;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .disciple-tree-item:hover .disciple-node-marker {
    transform: scale(1.3);
    background-color: #d4af37;
  }

  .disciple-tree-item:hover .disciple-node-card {
    transform: translateX(4px);
    border-color: #d4af37;
  }

  .disciple-node-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .badge-period {
    background-color: rgba(212, 175, 55, 0.15);
    color: var(--sgkb-primary, #d4af37);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  .badge-role {
    background-color: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  .disciple-node-title-link {
    text-decoration: none;
    color: inherit;
  }

  .disciple-node-title-link:hover .disciple-node-title {
    color: var(--sgkb-primary, #d4af37);
  }

  .disciple-node-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sgkb-text-main, #fff);
    transition: color 0.15s ease;
  }

  .disciple-node-org {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    color: var(--sgkb-text-muted, #9ca3af);
    font-style: italic;
  }

  .disciple-node-desc {
    margin: 0 0 0.75rem 0;
    font-size: 0.9rem;
    color: var(--sgkb-text-muted, #bbb);
    line-height: 1.5;
  }

  .disciple-node-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    background-color: var(--sgkb-bg-card, #222d3d);
    color: var(--sgkb-text-muted, #cbd5e1);
    border-radius: 4px;
    border: 1px solid var(--sgkb-border, #334155);
  }

  /* Điều khiển nút Bung ra / Thu gọn */
  .disciple-expand-control {
    display: flex;
    justify-content: center;
  }

  .expand-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--sgkb-bg-gray, #1a1a1a);
    border: 1px solid var(--sgkb-border, #333333);
    border-radius: 8px;
    color: var(--sgkb-primary, #d4af37);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .expand-toggle-btn:hover {
    background-color: rgba(212, 175, 55, 0.1);
    border-color: var(--sgkb-primary, #d4af37);
  }

  .expand-chevron {
    transition: transform 0.3s ease;
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
