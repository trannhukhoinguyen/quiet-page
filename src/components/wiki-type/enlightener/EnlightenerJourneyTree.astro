---
export interface Angya {
  title: string;
  year: number;
  age?: number;
  location?: string;
  description?: string;
}

interface Props {
  title?: string;
  currentSlug?: string;
  birthYear?: number;
  journeys?: Angya[];
  maxInitialDisplay?: number; // Số lượng hiển thị mặc định trước khi collapse (mặc định là 2)
}

const { journeys = [], title = "SƠ ĐỒ HÀNH TRẠNG DI CHUYỂN", birthYear, maxInitialDisplay = 2 } = Astro.props;
const remainedJourney = journeys.length - maxInitialDisplay;
---

<div
  class="archive-tree-wrapper"
  x-data="{ isExpanded: false }"
  x-init="
        window.addEventListener('keydown', (e) => {
          // Kiểm tra tổ hợp phím: Ctrl + Alt + C (không phân biệt chữ hoa/thường)
          if (e.ctrlKey && e.altKey && e.key.toLowerCase() === 'c') {
            e.preventDefault(); // Ngăn trình duyệt kích hoạt các phím tắt mặc định nếu có
            isExpanded = !isExpanded; // Đảo trạng thái collapse y hệt như khi click button
          }
        })
      "
>
  {title && <h3 class="archive-tree-header">
    {title} <span style="color: var(--color-accent-greenyellow)">{journeys.length ? ` (${journeys.length})` : ''}</span>
  </h3>}

  <div class="archive-tree-container">
    <ul class="archive-tree-list">
      { journeys.length > 0 && journeys.map((journey, index) => (
        <li
          class={`archive-tree-item ${index >= maxInitialDisplay ? 'extra-node' : ''}`}
          x-show={index >= maxInitialDisplay ? "isExpanded" : "true"}
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 transform -translate-y-2"
          x-transition:enter-end="opacity-100 transform translate-y-0"
        >
          <div class="archive-node-marker"></div>
          <div class="archive-node-card">
            {journey.year && (
              <div class="archive-node-meta">
                {journey.year && <span class="badge-year">📅 {journey.year}</span>}
                {<span class="badge-age">🌱 {birthYear && journey.year ? journey.year - birthYear :  journey.age ? journey.age : "unknown"} tuổi</span>}
              </div>
            )}

            { journey.title && <h4 class="archive-node-title">{ journey.title }</h4>}
            {
              journey.location && <div class="archive-node-desc">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{journey.location}</span>
              </div>
            }

            {journey.description && <p class="archive-node-desc">{journey.description}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>

  {/* Nút bấm Bung ra / Thu gọn nếu số lượng phần tử vượt quá giới hạn */}
  {remainedJourney > 0 && (
    <div class="archive-expand-control">
      <button
        type="button"
        class="expand-toggle-btn"
        @click="isExpanded = !isExpanded"
      >
        <span x-text="isExpanded ? 'Thu gọn bớt' : 'Xem thêm'"></span>
        <svg
          class="expand-chevron"
          :class="{ 'rotate-180': isExpanded }"
          width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        (+ {remainedJourney})
      </button>
    </div>
  )}
</div>

<style>
  // COLLAPSE
  .archive-tree-wrapper {
    margin: 2rem 0;
    padding: 1.5rem;
    background-color: var(--sgkb-bg-card, #121212);
    border: 1px solid var(--sgkb-border, #2a2a2a);
    border-radius: 12px;
  }

  .archive-tree-header {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sgkb-text-main, #ffffff);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--sgkb-border, #2a2a2a);
    padding-bottom: 0.75rem;
  }

  .archive-tree-container {
    position: relative;
    padding: 0.5rem 0 0.5rem 1rem;
  }

  .archive-tree-line {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 1.85rem;
    width: 2px;
    background: linear-gradient(180deg, var(--sgkb-primary, #d4af37) 0%, rgba(212, 175, 55, 0.2) 100%);
  }

  .archive-tree-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.5rem;
  }

  .archive-tree-item {
    position: relative;
    display: flex;
    gap: 1.5rem;
  }

  .archive-node-marker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    padding-top: 0.85rem;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #000;
    border: 2px solid var(--sgkb-primary, #d4af37);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
    flex-shrink: 0;
    margin-left: 2px;

    span {
      position: absolute;
    }
  }

  .archive-node-card {
    flex: 1;
    background-color: var(--sgkb-bg-gray, #1a1a1a);
    border: 1px solid var(--sgkb-border, #333333);
    border-radius: 10px;
    padding: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .archive-tree-item:hover .archive-node-line-connector .archive-node-marker {
    transform: scale(1.3);
    background-color: var(--sgkb-primary, #d4af37);
  }

  .archive-tree-item:hover .archive-node-card {
    border-color: var(--sgkb-primary, #d4af37);
    transform: translateX(4px);
  }

  .archive-node-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .badge-year {
    background-color: rgba(212, 175, 55, 0.15);
    color: var(--sgkb-primary, #d4af37);
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  .badge-age {
    background-color: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
  }

  .archive-node-title-link {
    text-decoration: none;
    color: inherit;
  }

  .archive-node-title-link:hover .archive-node-title {
    color: var(--sgkb-primary, #d4af37);
  }

  .archive-node-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sgkb-text-main, #fff);
    transition: color 0.15s ease;
  }

  .archive-node-org {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    color: var(--sgkb-text-muted, #9ca3af);
    font-style: italic;
  }

  .archive-node-desc {
    margin: 0 0 0.75rem 0;
    font-size: 0.9rem;
    color: var(--sgkb-text-muted, #bbb);
    line-height: 1.5;
  }

  .archive-node-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    background-color: var(--sgkb-bg-card, #222d3d);
    color: var(--sgkb-text-muted, #cbd5e1);
    border-radius: 4px;
    border: 1px solid var(--sgkb-border, #334155);
  }

  /* Điều khiển nút Bung ra / Thu gọn */
  .archive-expand-control {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
  }

  .expand-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--sgkb-bg-gray, #1a1a1a);
    border: 1px solid var(--sgkb-border, #333333);
    border-radius: 8px;
    color: var(--sgkb-primary, #d4af37);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .expand-toggle-btn:hover {
    background-color: rgba(212, 175, 55, 0.1);
    border-color: var(--sgkb-primary, #d4af37);
  }

  .expand-chevron {
    transition: transform 0.3s ease;
  }

  .rotate-180 {
    transform: rotate(180deg);
  }
</style>
